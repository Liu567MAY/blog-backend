APP_NAME=AKiL Blog
APP_ENV=development
DEBUG=true

DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/akil_blog?charset=utf8mb4

# 必填：JWT 签名密钥，请生成随机值，例如 python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_EXPIRE_MINUTES=1440

# 可选：管理员初始化脚本（python -m scripts.init_admin）非交互模式使用
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# 阿里云 OSS 图片直传（全部配置后才允许签发上传 URL；不要提交真实 AccessKey）
# Bucket 名称，例如 your-blog-images
OSS_BUCKET=
# 地域 Endpoint，例如 https://oss-cn-hangzhou.aliyuncs.com
OSS_ENDPOINT=
# 地域 ID，例如 cn-hangzhou
OSS_REGION=
# 最小权限 RAM 用户 AccessKey，仅授予指定前缀的 PutObject 权限
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 图片长期访问域名，例如 https://img.example.com（可为 OSS 自定义域名或 CDN）
OSS_PUBLIC_BASE_URL=
# 上传签名有效期（秒），范围 60–3600，默认 5 分钟
OSS_UPLOAD_EXPIRE_SECONDS=300
# 单张图片最大字节数，默认 10MB
OSS_MAX_IMAGE_SIZE_BYTES=10485760
# Object Key 前缀
OSS_UPLOAD_PREFIX=articles
